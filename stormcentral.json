{
  "type": "plugin",
  "name": "Conditions",
  "author": "Zenitsu132",
  "description": "Adds current ground conditions, like snow depth and drought, to the map.",
  "version": "1.0.0",
  "layers": [
    {
      "type": "raster",
      "id": "snow-depth",
      "name": "Snow Depth",
      "tiles": [
        "https://mapservices.weather.noaa.gov/raster/rest/services/snow/NOHRSC_Snow_Analysis/MapServer/export?bbox={bbox-epsg-3857}&bboxSR=3857&imageSR=3857&size=256,256&format=png32&transparent=true&layers=show:0&f=image"
      ],
      "maxzoom": 12,
      "opacity": 0.9,
      "visible": false,
      "attribution": "Snow Depth: NOAA/NWS NOHRSC"
    },
    {
      "type": "raster",
      "id": "drought-monitor",
      "name": "Drought Monitor",
      "tiles": [
        "https://gis.fema.gov/arcgis/rest/services/Partner/Drought_Current/MapServer/export?bbox={bbox-epsg-3857}&bboxSR=3857&imageSR=3857&size=256,256&format=png32&transparent=true&layers=show:0&f=image"
      ],
      "maxzoom": 12,
      "opacity": 0.7,
      "visible": false,
      "attribution": "Drought Monitor: National Drought Mitigation Center, USDA, NOAA (via FEMA)"
    }
  ]
}